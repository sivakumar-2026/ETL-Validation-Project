# MSSQL Source (SQL Login)
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=Sourcedb
MSSQL_USER=sa
MSSQL_PASSWORD=your_mssql_password
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_TRUST_SERVER_CERTIFICATE=yes
MSSQL_ENCRYPT=optional

# PostgreSQL Target
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=Targetdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# Table mapping
SRC_TABLE=dbo.Album
TGT_TABLE=public.album
PRIMARY_KEY=ALBUMID

# JDBC jars for PySpark (local paths)
MSSQL_JDBC_JAR=/absolute/path/to/mssql-jdbc-12.4.2.jre11.jar
POSTGRES_JDBC_JAR=/absolute/path/to/postgresql-42.7.1.jar

# Email alerts (Gmail App Password required)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your_gmail@gmail.com
ALERT_EMAIL=sivakumartorur@gmail.com
